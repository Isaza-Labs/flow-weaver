# =============================================================================
# FlowWeaver — example environment file
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values:   cp .env.example .env
# NEVER commit your real `.env` (it is git-ignored).
#
# NOTE: variable names below are a STARTING TEMPLATE based on the documented
# setup (database, inference, secrets, ports). Reconcile them with the app's
# actual configuration binding before relying on them. ASP.NET Core maps
# nested config keys using a double underscore, e.g. Section__Key.
# =============================================================================

# ----- Ports (all overridable; the app reads these everywhere) ---------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432

# ----- Database (PostgreSQL 16) ----------------------------------------------
# Used by docker-compose to provision Postgres:
POSTGRES_USER=flowweaver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowweaver
# Connection string the backend uses (host is the compose service name):
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=flowweaver;Username=flowweaver;Password=change-me

# ----- Inference / LLM provider ----------------------------------------------
# Choose ONE tier.
#  (a) Commercial API: set the provider base URL + key.
#  (b) Sovereign / air-gapped: point to a local model (e.g. Ollama) and leave the key blank.
LLM__Provider=openai
LLM__BaseUrl=https://api.openai.com
LLM__ApiKey=change-me
# Local/sovereign example:
# LLM__Provider=ollama
# LLM__BaseUrl=http://ollama:11434
# LLM__ApiKey=

# ----- Auth / JWT ------------------------------------------------------------
# The app refuses to boot with a weak/empty signing key — set a strong secret.
Jwt__SigningKey=change-me-to-a-long-random-secret
Jwt__Issuer=flowweaver
Jwt__Audience=flowweaver

# ----- Data Protection keyring / secret encryption ---------------------------
DataProtection__KeyRingPath=/var/lib/flowweaver/keyring
# Optional KMS wrapping of the keyring (leave blank to use filesystem only):
# DataProtection__Kms__Provider=aws
# DataProtection__Kms__KeyId=

# ----- Email (optional; disabled by default) ---------------------------------
# Smtp__Host=
# Smtp__Port=587
# Smtp__Username=
# Smtp__Password=

# ----- Security / feature flags ----------------------------------------------
# Allow calls to private/internal URLs — DEV ONLY, keep false in production:
Security__AllowInternalUrls=false
# RBAC and capability settings must be copied from the application's current
# configuration schema. Do not restore the retired GranularGatingEnabled flag.
# Allow destructive SSH commands (reload/erase/...) — keep false unless intended:
Ssh__AllowDestructiveCommands=false

# ----- Runtime environment ---------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
