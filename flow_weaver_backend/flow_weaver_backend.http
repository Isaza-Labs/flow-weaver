@flow_weaver_backend_HostAddress = http://localhost:5228
@contentType = application/json

### Ejemplos listos para REST Client / JetBrains HTTP Client.
### Pega el id que devuelve cada POST en la variable correspondiente para
### encadenar las llamadas (create → update → delete).

@deviceId = 00000000-0000-0000-0000-000000000001
@credentialId = 00000000-0000-0000-0000-000000000001
@inventorySourceId = 00000000-0000-0000-0000-000000000001
@devicePoolId = 00000000-0000-0000-0000-000000000001
@serviceDefinitionId = 00000000-0000-0000-0000-000000000001
@workflowId = 00000000-0000-0000-0000-000000000001
@workflowTriggerId = 00000000-0000-0000-0000-000000000001
@workflowPlanId = 00000000-0000-0000-0000-000000000001
@skillId = 00000000-0000-0000-0000-000000000001
@integrationId = 00000000-0000-0000-0000-000000000001
@integrationActionId = 00000000-0000-0000-0000-000000000001
@aiProviderId = 00000000-0000-0000-0000-000000000001
@aiAgentId = 00000000-0000-0000-0000-000000000001

### ═══════════════════════════════════════════════════════════════
###  OpenAPI — documentación generada
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/openapi/v1.json
Accept: application/json

### ═══════════════════════════════════════════════════════════════
###  Device  /api/device
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/device
Accept: application/json

###
GET {{flow_weaver_backend_HostAddress}}/api/device/{{deviceId}}
Accept: application/json

###
POST {{flow_weaver_backend_HostAddress}}/api/device
Content-Type: {{contentType}}

{
  "device_name": "router-01",
  "ip_address": "10.0.0.1",
  "platform": "cisco_ios",
  "vendor": "Cisco",
  "os_version": "17.9.3",
  "site": "core-dc1",
  "role": "edge-router",
  "status": "active"
}

###
PUT {{flow_weaver_backend_HostAddress}}/api/device/{{deviceId}}
Content-Type: {{contentType}}

{
  "status": "maintenance"
}

###
DELETE {{flow_weaver_backend_HostAddress}}/api/device/{{deviceId}}

