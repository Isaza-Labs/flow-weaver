Content-Type: {{contentType}}

{
  "name": "cisco-lab-admin",
  "type": "ssh_password",
  "username": "admin",
  "password": "S3cret!"
}

###
PUT {{flow_weaver_backend_HostAddress}}/api/credential/{{credentialId}}
Content-Type: {{contentType}}

{
  "password": "NewS3cret!"
}

###
DELETE {{flow_weaver_backend_HostAddress}}/api/credential/{{credentialId}}

### ═══════════════════════════════════════════════════════════════
###  InventorySource  /api/inventorysource
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/inventorysource

###
GET {{flow_weaver_backend_HostAddress}}/api/inventorysource/{{inventorySourceId}}

###
POST {{flow_weaver_backend_HostAddress}}/api/inventorysource
Content-Type: {{contentType}}

{
  "name": "netbox-prod",
  "type": "netbox",
  "description": "Pull every device from the NetBox prod tenant",
  "config": { "base_url": "https://netbox.example.com", "token": "..." },
  "sync_mode": "periodic",
  "enabled": true
}

###
PUT {{flow_weaver_backend_HostAddress}}/api/inventorysource/{{inventorySourceId}}
Content-Type: {{contentType}}

{ "enabled": false }

###
DELETE {{flow_weaver_backend_HostAddress}}/api/inventorysource/{{inventorySourceId}}

