### ═══════════════════════════════════════════════════════════════
###  Workflow  /api/workflow
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/workflow

###
GET {{flow_weaver_backend_HostAddress}}/api/workflow/{{workflowId}}

###
POST {{flow_weaver_backend_HostAddress}}/api/workflow
Content-Type: {{contentType}}

{
  "name": "backup-edge-routers",
  "description": "Nightly config backup for every edge router",
  "nodes": [],
  "edges": []
}

###
PUT {{flow_weaver_backend_HostAddress}}/api/workflow/{{workflowId}}
Content-Type: {{contentType}}

{
  "description": "Now runs at 02:00 UTC",
  "change_summary": "Rescheduled nightly run"
}

###
DELETE {{flow_weaver_backend_HostAddress}}/api/workflow/{{workflowId}}

### Nested — create a trigger bound to a workflow
POST {{flow_weaver_backend_HostAddress}}/api/workflow/{{workflowId}}/triggers
Content-Type: {{contentType}}

{
  "name": "nightly-02-utc",
  "type": "cron",
  "cron_expression": "0 2 * * *",
  "timezone": "UTC",
  "enabled": true,
  "notify_on": ["failure"]
}

### ═══════════════════════════════════════════════════════════════
###  WorkflowTrigger  /api/workflowtrigger
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/workflowtrigger

###
GET {{flow_weaver_backend_HostAddress}}/api/workflowtrigger/{{workflowTriggerId}}

### Creación plana — rechazada a propósito (usa /api/workflow/{id}/triggers)
POST {{flow_weaver_backend_HostAddress}}/api/workflowtrigger
Content-Type: {{contentType}}

{ "name": "x", "type": "cron" }

###
PUT {{flow_weaver_backend_HostAddress}}/api/workflowtrigger/{{workflowTriggerId}}
Content-Type: {{contentType}}

{ "enabled": false }

###
DELETE {{flow_weaver_backend_HostAddress}}/api/workflowtrigger/{{workflowTriggerId}}

### ═══════════════════════════════════════════════════════════════
###  WorkflowPlan  /api/workflowplan
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/workflowplan

###
GET {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}

###
POST {{flow_weaver_backend_HostAddress}}/api/workflowplan
Content-Type: {{contentType}}

{
  "intent": "Back up every edge router nightly",
  "description": "Use ping + save-config + archive",
  "target_pools": []
}

###
PUT {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}
Content-Type: {{contentType}}

{ "description": "Also archive running-config" }

### Governance — draft → awaiting_approval
POST {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}/submit

### Governance — awaiting_approval → approved
POST {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}/approve
Content-Type: {{contentType}}

{ "approved_by": "roberto@example.com" }

### Governance — awaiting_approval → rejected
POST {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}/reject
Content-Type: {{contentType}}

{
  "approved_by": "roberto@example.com",
  "reason": "Targets production without a maintenance window"
}

### Governance — approved → built  (stub hasta Fase 3)
POST {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}/build

###
DELETE {{flow_weaver_backend_HostAddress}}/api/workflowplan/{{workflowPlanId}}

### ═══════════════════════════════════════════════════════════════
###  Skill  /api/skill
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/skill

###
POST {{flow_weaver_backend_HostAddress}}/api/skill
Content-Type: {{contentType}}

{
  "name": "backup-config",
  "skill_type": "workflow",
  "triggers": ["backup", "save config"],
  "action_config": { "workflow_ref": "backup-edge-routers" },
  "enabled": true
}

###
GET {{flow_weaver_backend_HostAddress}}/api/skill/{{skillId}}

###
PUT {{flow_weaver_backend_HostAddress}}/api/skill/{{skillId}}
Content-Type: {{contentType}}

{ "enabled": false }

###
DELETE {{flow_weaver_backend_HostAddress}}/api/skill/{{skillId}}

### ═══════════════════════════════════════════════════════════════
###  Integration  /api/integration
### ═══════════════════════════════════════════════════════════════

GET {{flow_weaver_backend_HostAddress}}/api/integration

###
GET {{flow_weaver_backend_HostAddress}}/api/integration/{{integrationId}}

###
POST {{flow_weaver_backend_HostAddress}}/api/integration
Content-Type: {{contentType}}

{
  "name": "netbox",
  "type": "netbox",
  "base_url": "https://netbox.example.com/api",
  "auth_config": { "method": "token", "token": "abcdef123" },
  "tls_skip_verify": false
}

###
PUT {{flow_weaver_backend_HostAddress}}/api/integration/{{integrationId}}
Content-Type: {{contentType}}

{ "enabled": false }

###
DELETE {{flow_weaver_backend_HostAddress}}/api/integration/{{integrationId}}

### Nested — create an action under this integration
POST {{flow_weaver_backend_HostAddress}}/api/integration/{{integrationId}}/actions
Content-Type: {{contentType}}

{
  "name": "list-devices",
  "method": "GET",
  "path": "/dcim/devices/",
  "category": "inventory"
}

### Transactional bundle — integration + skills + specs in one shot
POST {{flow_weaver_backend_HostAddress}}/api/integration/bundle
Content-Type: {{contentType}}

{
  "integration": {
    "name": "netbox",
    "type": "netbox",
    "base_url": "https://netbox.example.com/api",
    "auth_config": { "method": "token", "token": "abcdef123" }
  },
  "skills": [
    { "name": "netbox.md", "content": "# NetBox\nUse this integration for…", "sort_order": 100 }
  ],
  "specs": [
    { "api": "netbox", "content": "openapi: 3.0.0\npaths: {}\n" }
  ]
}

