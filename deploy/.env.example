# FlowWeaver deployment configuration.
#
# Copy to `.env` (in this `deploy/` directory, next to docker-compose.yml) and
# edit. Docker Compose substitutes ${VAR} from this file; the compose maps each
# one to the right container env var (e.g. MESSAGING_PUBLIC_BASE_URL →
# Messaging__PublicBaseUrl). Values shown are the compose defaults — a var left
# unset falls back to the default in parentheses, EXCEPT JWT_KEY which is
# required. After editing, apply with: `docker compose up -d` (a `restart` does
# NOT re-read .env).

# ─── Host ports ──────────────────────────────────────────────────────
# Host-side port → fixed container port. Change these when the defaults are
# already taken on the host; they don't affect inter-container traffic.
FRONTEND_PORT=3000          # browser → frontend            (container 3000)
BACKEND_PORT=8080           # browser/API clients → backend (container 8080)
POSTGRES_PORT=5432          # host tools → Postgres          (container 5432)

# ─── Postgres ────────────────────────────────────────────────────────
# Used by the `db` service AND the backend/worker connection string. Change
# the password before any real deployment.
#
# A literal `$` in a password must be written `$$` — Compose interpolates a
# single one and would silently truncate the value. run.sh / run.ps1 handle
# that escaping for you.
POSTGRES_DB=flowweaver
POSTGRES_USER=flowweaver
POSTGRES_PASSWORD=change-me

# ─── Which database ──────────────────────────────────────────────────
# DB_MODE is read by run.sh / run.ps1 only (Compose ignores it) to decide
# whether to start the bundled Postgres and whether to layer
# compose.external-db.yml on top.
#   docker   (default) → the `db` service in this compose project
#   external           → a Postgres you run elsewhere; the `db` service is
#                        not started and its dependency is dropped
DB_MODE=docker
#
# Where backend/worker connect. With DB_MODE=docker leave these alone: `db` is
# the service name on the compose network and 5432 is its container port
# (POSTGRES_PORT above is only the HOST-side publication, irrelevant here).
# With DB_MODE=external point them at the real server. For a Postgres running
# on the Docker host itself use host.docker.internal — `localhost` inside a
# container is the container.
DB_HOST=db
DB_PORT=5432

# ─── Runtime mode ────────────────────────────────────────────────────
# Development | Production.
#   Production  (default) → no Swagger, generic error pages, strict startup
#                           checks (e.g. refuses a default JWT key). Use this
#                           for anything reachable by users.
#   Development           → Swagger UI, detailed errors, the default-JWT-key
#                           guard is relaxed, logs default to `pretty`. Handy
#                           while debugging; not for a shared/exposed server.
ASPNETCORE_ENVIRONMENT=Production

# ─── JWT (authentication) ────────────────────────────────────────────
# Shared by backend + worker — the values MUST match across both (they sign
# and validate the same tokens, including the ones the messaging agent mints
# for its own internal API calls).
# JWT_KEY is REQUIRED: >=32 chars, unique per instance. Boot fails outside
# Development if it's missing or matches a known default. Generate one with:
#   openssl rand -base64 48
JWT_KEY=ThisIsADevelopmentKeyThatMustBeAtLeast32CharsLong!
JWT_ISSUER=flow-weaver
JWT_AUDIENCE=flow-weaver

# ─── Frontend ────────────────────────────────────────────────────────
# Public origin the browser loads the app from — passed to SvelteKit as ORIGIN
# (used for form-action / CSRF origin checks). Use the exact scheme+host+port
# your users hit, with NO trailing slash (a trailing "/" can trip origin
# checks). Example for a VPN-internal host: http://xxx.xxx.xxx.xx:3002
FRONTEND_ORIGIN=http://localhost:3000

# ─── Messaging channels (Slack / Telegram / WhatsApp / Teams) ─────────
# Public, user-facing base URL of the FRONTEND (NOT the backend). The bot uses
# it to build the account-linking link it DMs ("…/link?token=…") and, for
# webhook providers, the inbound webhook URL shown in the admin UI. Point it at
# the address your users actually reach — the VPN-internal host, or your
# public/tunnel hostname. No trailing slash.
# Leave empty and the bot can't send a working link (it degrades to a "link
# from the web app first" message and logs `messaging.link.no_public_base_url`).
# Example: MESSAGING_PUBLIC_BASE_URL=http://xxx.xxx.xxx.xx:3002
MESSAGING_PUBLIC_BASE_URL=

# Bot token for the native `slack_message` snippet (a workflow step that posts to
# a Slack channel). `xoxb-…` with the `chat:write` scope; the bot must be a
# member of the target channel. Separate from the messaging channels above —
# this is the deployment-configured token for the built-in snippet. Empty
# disables it (the step errors with a clear message). (default empty)
# SLACK_BOT_TOKEN=

# ─── Workflow engine ─────────────────────────────────────────────────
# Which environment this deployment represents. Gates which workflows may
# run: dev-sandbox → drafts only (default), qa-lab → qa, production →
# production. Drafts run on any worker. Set this to run qa/production
# workflows on this box. (default dev-sandbox)
# WORKER_ENVIRONMENT=dev-sandbox

# ─── AI assistant ────────────────────────────────────────────────────
# Max seconds an LLM chat stream (SSE) may run before the server cuts it off.
# Keep it under the 5-minute HTTP transport timeout so the turn ends with a
# message rather than a dropped connection. (default 240)
# AI_STREAM_DEADLINE_SECONDS=240
#
# Dump every raw SSE chunk from the LLM providers at Debug. Extremely noisy and
# can contain prompt text — triage only, never leave on in production.
# (default false)
# AI_LOG_PAYLOADS=false

# ─── Logging ─────────────────────────────────────────────────────────
# All levels accept any Serilog value: Verbose, Debug, Information, Warning,
# Error, Fatal (case-insensitive); unknown values fall back to the default.
#
# Console format:
#   pretty → colored single-line, human-readable (good for `docker logs -f`)
#   json   → CLEF one-event-per-line (good for Loki / Elastic / Datadog)
# Unset auto-picks: pretty in Development, json otherwise.
# LOG_FORMAT=pretty
#
# EF Core SQL (Microsoft.EntityFrameworkCore.Database.Command). Default Warning
# = silent (errors/timeouts only). Set Information to see every query + timing
# while hunting N+1 / slow queries — very noisy; revert when done. (default Warning)
# LOG_EF_SQL=Warning
#
# Application-services tree (flow_weaver_backend.Services.*: workflow / worker /
# engine / integration / device / credential / auth / policy + integration HTTP
# calls, secret hits, health probes).
#   Information (default) → starts, dispatches, handler begin/end, completions.
#   Debug                 → + per-device loops, per-command policy checks,
#                           variable resolves. For deep-diving a specific bug.
#   Warning               → only state-change + error lines; near-silent.
# The `.Services.Ai` chat/agent subtree is pinned to Debug regardless (longest
# prefix wins) since it's the hottest surface for diagnosing agent behaviour.
# LOG_ACTIONS=Information

# ─── Observability / tracing ─────────────────────────────────────────
# How many days of trace_events (one row per chat turn, workflow run and tool
# call) to keep. A background sweeper runs on boot and every 6h, deleting rows
# older than this. Lower it to shrink the DB footprint; raise it for more
# forensic history. Minimum 1. Applies to both backend and worker (both sweep).
# (default 365)
# TRACE_RETENTION_DAYS=365

# ─── Load-test device simulation (NFR-004 / staging only) ────────────
# When on, the ping/ssh/ansible step handlers are FAKED (synthetic latency, no
# real device I/O), so you can scale a STAGING box to thousands of synthetic
# devices and read p95/throughput/error from /api/admin/metrics/slo. NEVER for a
# box that manages real devices: boot is refused when WORKER_ENVIRONMENT=production.
# Seed with POST /api/admin/loadtest/seed. See docs/ops/load-testing.md. (default false)
# SIMULATION_ENABLED=false
# SIMULATION_LATENCY_MS=50      # base synthetic per-step latency
# SIMULATION_FAILURE_RATE=0     # 0..1 fraction of steps that "fail" (error-rate curve)

# ─── Python sandbox tuning (worker only) ─────────────────────────────
# The worker runs python_snippet inside a bwrap sandbox that creates user/pid/
# mount namespaces. These cap and harden that.
#
# Max simultaneous bwrap launches across the worker. Lower on a host with a
# tight `user.max_user_namespaces`; raise once that sysctl is bumped. (default 4)
# PYTHON_MAX_CONCURRENT_SANDBOXES=4
#
# Extra attempts when a sandbox fails to CREATE its namespace (the script never
# ran on a setup failure, so retrying is side-effect free). (default 4)
# PYTHON_SANDBOX_SETUP_RETRIES=4
#
# prlimit --nproc cap for the sandbox. RLIMIT_NPROC is per-UID so it also counts
# the worker's own threads — keep it well above the worker's baseline or bwrap's
# clone() fails with EAGAIN. Raise on a busy worker. (default 1024)
# PYTHON_MAX_PROCESSES=1024
#
# Admin-approved python_snippet packages (the /admin allow-list) are installed
# wheels-only by default, so pip never builds or runs sdist packaging code. Set
# false to allow source installs for packages that ship no wheel. (default true)
# PYTHON_PIP_ONLY_BINARY=true

# ─── Public ingress tunnel (optional) ────────────────────────────────
# Only for hosts with NO inbound internet that still need a PUBLIC webhook
# (e.g. Slack Events API without Socket Mode). Create a Cloudflare Tunnel
# routed to http://backend:8080, paste its token here, set
# MESSAGING_PUBLIC_BASE_URL to the tunnel's public hostname, and start it with:
#   docker compose --profile tunnel up -d cloudflared
# Not needed for Slack Socket Mode or a VPN-only deployment.
# CLOUDFLARE_TUNNEL_TOKEN=
