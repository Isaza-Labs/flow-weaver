{
  "id": "bundle.refused.plain_ssh_secret_is_untranslatable",
  "family": "bundle",
  "contract_version": "1.1.0-draft",
  "description": "snippets/SPEC.md `ssh`: password, private_key and key_passphrase are not portable as PLAIN values. The importer refuses the node with bundle_reference_untranslatable unless the value is a ${secret:…} reference, which is preserved verbatim and listed in requires.secrets. Accepting a marker it would then send on the wire is the failure this refusal exists for.",
  "input": {
    "bundle": {
      "schema_version": "v3",
      "kind": "flow_weaver.workflow_bundle",
      "requires": { "snippet_types": [ "ssh" ], "capabilities": [], "secrets": [] },
      "workflow": { "name": "audit" },
      "nodes": [
        { "id": "start", "snippet_id": "__start__" },
        { "id": "show", "snippet_id": "aaaaaaaa-0000-0000-0000-000000000004", "config_overrides": { "commands": [ "show version" ], "username": "netops", "password": "hunter2" } }
      ],
      "edges": [ { "source": "start", "target": "show", "type": "success" } ],
      "dependencies": {
        "snippets": [ { "id": "aaaaaaaa-0000-0000-0000-000000000004", "slug": "show-version", "name": "Show version", "type": "ssh", "target_mode": "per_device", "timeout_seconds": 30 } ]
      }
    },
    "local": { "snippet_types": [ "ssh" ] }
  },
  "expected": { "outcome": "refused", "codes": [ "bundle_reference_untranslatable" ] },
  "equivalence": "subset",
  "oracle_commit": "fw@1a11ea3"
}
