      "nodes": [
        { "id": "start", "snippet_id": "__start__" },
        { "id": "show", "snippet_id": "aaaaaaaa-0000-0000-0000-000000000004", "config_overrides": { "commands": [ "show version" ], "credential_id": "cccccccc-0000-0000-0000-00000000000c" } }
      ],
      "edges": [ { "source": "start", "target": "show", "type": "success" } ],
      "dependencies": {
        "snippets": [ { "id": "aaaaaaaa-0000-0000-0000-000000000004", "slug": "show-version", "name": "Show version", "type": "ssh", "target_mode": "per_device", "timeout_seconds": 30 } ],
